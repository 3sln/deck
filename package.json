{
  "name": "@3sln/deck",
  "version": "0.0.14",
  "description": "Scalable, zero-config, Markdown-based component playgrounds and documentation sites. Runs on Vite, @web/dev-server, Rspack/webpack, or its own bundler-free dev server.",
  "type": "module",
  "author": "Ray Stubbs",
  "repository": {
    "type": "git",
    "url": "https://github.com/3sln/deck.git"
  },
  "scripts": {
    "format": "prettier -w \"**/*.js\"",
    "test": "bun test"
  },
  "license": "MIT",
  "keywords": [
    "vite",
    "web-dev-server",
    "webpack",
    "rspack",
    "plugin",
    "documentation",
    "markdown",
    "component",
    "playground"
  ],
  "exports": {
    ".": "./src/main.js",
    "./vite-plugin": "./vite-plugin.js",
    "./wds-plugin": "./wds-plugin.js",
    "./webpack-plugin": "./webpack-plugin.js",
    "./dev-core": "./src/dev-core.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "deck-build": "./bin/build.js",
    "deck-dev": "./bin/dev.js"
  },
  "files": [
    "bin/",
    "src/",
    "vite-plugin.js",
    "wds-plugin.js",
    "webpack-plugin.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@3sln/dodo": "^0.0.10",
    "@3sln/ngin": "^0.0.4",
    "esbuild": "^0.25.0",
    "fs-extra": "^11.3.2",
    "glob": "^10.3.10",
    "highlight.js": "^11.9.0",
    "marked": "^16.3.0"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@web/dev-server": "^0.4.6",
    "happy-dom": "^18.0.1",
    "prettier": "^3.6.2",
    "vite": "^5.4.20"
  }
}
